<VisualStudioPropertySheet
	ProjectType="Visual C++"
	Version="8.00"
	Name="NavajoPhone"
	InheritedPropertySheets="..\src\navajo.vsprops"
	>
	<UserMacro
		Name="PHONE_FEATURE_DEFINES_2003"
		Value="FEATURE_WIFI"
		PerformEnvironmentSet="true"
	/>
	<UserMacro
		Name="PHONE_FEATURE_DEFINES"
		Value="FEATURE_SMS;FEATURE_WIFI;FEATURE_RIL;FEATURE_RAS;FEATURE_PHONE_NUMBER;FEATURE_TOOLHELP"
		PerformEnvironmentSet="true"
	/>
	<UserMacro
		Name="PHONE_INCLUDE_DIRS"
		Value="..\tinCan"
		PerformEnvironmentSet="true"
	/>
	<UserMacro
		Name="PHONE_LIBRARY_DIRS"
		Value="..\tinCan\$(PlatformName)\$(ConfigurationName)"
		PerformEnvironmentSet="true"
	/>
	<UserMacro
		Name="PHONE_LIBS"
		Value="aygshell.lib iphlpapi.lib sms.lib tinCan.lib ws2.lib toolhelp.lib"
		PerformEnvironmentSet="true"
	/>
</VisualStudioPropertySheet>
