/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PHONE DIALOG  0, 0, 136, 103
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | 0x4000L
CAPTION "AlphaCipher Mobile"
FONT 8, "MS Shell Dlg"
BEGIN
    LISTBOX         IDC_CONTACT,7,7,122,83,LBS_SORT | WS_VSCROLL | WS_TABSTOP
    CTEXT           "",IDC_STATUS,7,87,122,9,SS_NOPREFIX
END


/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO 
BEGIN
    IDD_PHONE, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 129
        TOPMARGIN, 7
        BOTTOMMARGIN, 96
    END
END
#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU 
BEGIN
    POPUP "Menu"
    BEGIN
        MENUITEM "Dial",                        ID_MAIN_DIAL
        MENUITEM "Hangup",                      ID_MAIN_HANGUP
        MENUITEM SEPARATOR
        MENUITEM "Host Info",                   ID_MAIN_HOST
        MENUITEM SEPARATOR
        MENUITEM "About",                       ID_MAIN_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        ID_MAIN_EXIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_PHONE ACCELERATORS 
BEGIN
    "C",            ID_CONTACT,             VIRTKEY, CONTROL, NOINVERT
    "D",            ID_DIAL,                VIRTKEY, CONTROL, NOINVERT
    "H",            ID_HANGUP,              VIRTKEY, CONTROL, NOINVERT
    "X",            ID_EXIT,                VIRTKEY, CONTROL, NOINVERT
    VK_F1,          ID_ABOUT,               VIRTKEY, NOINVERT
    VK_F2,          ID_HOST,                VIRTKEY, NOINVERT
END

#endif    // English (U.S.) resources
